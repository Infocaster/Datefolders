{
	"$schema": "/App_Plugins/manifestSchema.json",
	"propertyEditors": [
		{
			"alias": "Infocaster.NodeNameSync",
			"name": "Node name sync",
			"editor": {
				"view": "~/App_Plugins/Infocaster.NodeNameSync/Infocaster.NodeNameSync.html",
				"valueType": "STRING"
			}
		}
	],
	"javascript": [ "~/App_Plugins/Infocaster.NodeNameSync/Infocaster.NodeNameSync.controller.js" ],
	"css": [ "~/App_Plugins/Infocaster.NodeNameSync/Infocaster.NodeNameSync.css" ]
}