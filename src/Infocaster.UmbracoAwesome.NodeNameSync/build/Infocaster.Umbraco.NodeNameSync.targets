<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <NodeNameSyncPluginFolder>App_Plugins\Infocaster.NodeNameSync</NodeNameSyncPluginFolder>
        <NodeNameSyncContentFilesPath>$(MSBuildThisFileDirectory)..\content\$(NodeNameSyncPluginFolder)\**\*.*</NodeNameSyncContentFilesPath>
    </PropertyGroup>

    <Target Name="CopyNodeNameSyncAssets" BeforeTargets="Build">
        <ItemGroup>
            <NodeNameSyncContentFiles Include="$(NodeNameSyncContentFilesPath)" />
        </ItemGroup>
        <Message Text="Copying NodeNameSync files: $(NodeNameSyncContentFilesPath) - #@(NodeNameSyncContentFiles->Count()) files"  Importance="high" />
        <Copy
            SourceFiles="@(NodeNameSyncContentFiles)"
            DestinationFiles="@(NodeNameSyncContentFiles->'$(MSBuildProjectDirectory)\$(NodeNameSyncPluginFolder)\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
    </Target>

    <Target Name="ClearNodeNameSyncAssets" BeforeTargets="Clean">
        <ItemGroup>
            <NodeNameSyncDir Include="$(MSBuildProjectDirectory)\$(NodeNameSyncPluginFolder)\" />
        </ItemGroup>
        <Message Text="Clear old NodeNameSync data"  Importance="high" />
        <RemoveDir Directories="@(NodeNameSyncDir)"  />
    </Target>

</Project>